cpp
// Prints the graph structure in the same format as the data file, in ascending node order
void Graph::dump() {
    if (empty()) {
            cout << 0 << endl;
	            return;
		        }

    cout << m_numNodes << endl;

    for (int i = 0; i < m_numNodes; i++) {
            Node* current = findNode(i);
	            if (current == nullptr) continue;

        // Print node value
	        cout << current->getValue() << " ";

        // Print each directional neighbor, or -1 if nullptr
	        Node* directions[4] = {
		            current->getNorth(),
			                current->getEast(),
					            current->getSouth(),
						                current->getWest()
								        };

        for (int j = 0; j < 4; j++) {
	            if (directions[j] != nullptr)
		                    cout << directions[j]->getValue();
				                else
						                cout << -1;
								            if (j < 3) cout << " ";
									            }
										            cout << endl;
											        }
												}
												The tradeoff is it's O(n²) due to calling findNode() for each value, but for typical graph sizes that should be fine. Ready for the next one!

