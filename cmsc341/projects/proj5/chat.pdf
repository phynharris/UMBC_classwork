cpp
// Deletes all dynamically allocated nodes and resets all member variables
void Graph::clearGraph() {
    Node* current = m_head;
        while (current != nullptr) {
	        Node* next = current->getNext();
		        delete current;
			        current = next;
				    }

    m_head = nullptr;
        m_numNodes = 0;
	    m_dataFile = "";
	        clearResult();
		}
		The key detail here is saving current->getNext() into a temporary next pointer before deleting current — otherwise we'd be dereferencing deleted memory when trying to advance through the list. Ready for the next one!

