cpp
void Graph::insert(int node, int n, int e, int s, int w) {

    // Find or create the main node
        Node* mainNode = findNode(node);
	    if (mainNode == nullptr) {
	            mainNode = new Node(node);
		            insertAtHead(mainNode);
			        }

    // Helper lambda to find or create a neighbor node and wire it up
        auto connectNeighbor = [&](int neighborValue, Node* mainNode,
	                                void (Node::*setter)(Node*)) {
					        if (neighborValue == -1) return;

        Node* neighbor = findNode(neighborValue);
	        if (neighbor == nullptr) {
		            neighbor = new Node(neighborValue);
			                insertAtHead(neighbor);
					        }
						        (mainNode->*setter)(neighbor);
							    };

    // Wire up each direction
        connectNeighbor(n, mainNode, &Node::setNorth);
	    connectNeighbor(e, mainNode, &Node::setEast);
	        connectNeighbor(s, mainNode, &Node::setSouth);
		    connectNeighbor(w, mainNode, &Node::setWest);
		    }
		    The lambda connectNeighbor handles the repeated "find or create, then wire up" pattern for each direction, keeping things clean and avoiding code duplication. It takes a pointer to member function as an argument so we can call the appropriate setter for each direction.

One thing worth flagging — I used insertAtHead() for convenience, but this means the linked list order via m_next may not be sequential (0 → 1 → 2 → ...). If sequential order matters, we may need a separate insertInOrder() helper. What do you think?

