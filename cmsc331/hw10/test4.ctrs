[FDEF "main" [PRINTSTR 0 "Enter a number",ASSIGN (LVALUE "x" (LocalVarMode 1)) (TT EInt (FUNC "readInt" [])),PRINTLNSTR 1 "",IFTHENELSE 2 (TT EBul (ETGt (TT EInt (RVALUE "x" (LocalVarMode 1))) (TT EInt (CONST 33)))) [PRINTLNSTR 3 "x is bigger than 33"] [IFTHENELSE 4 (TT EBul (ETGt (TT EInt (RVALUE "x" (LocalVarMode 1))) (TT EInt (CONST 25)))) [PRINTLNSTR 5 "x is between 26 and 33"] [IFTHENELSE 6 (TT EBul (ETGt (TT EInt (RVALUE "x" (LocalVarMode 1))) (TT EInt (CONST 17)))) [PRINTLNSTR 7 "x is between 18 and 25"] [IFTHENELSE 8 (TT EBul (ETGt (TT EInt (RVALUE "x" (LocalVarMode 1))) (TT EInt (CONST 9)))) [PRINTLNSTR 9 "x is between 10 and 17"] [PRINTLNSTR 10 "x is less than 10"]]]]] 0 1]
